rules_version = '2';

// CleanTrail Firestore 보안 규칙.
//
// 이 파일은 코드로만 남겨둔 참고용이며, 실제 적용은 Firebase Console의
// Firestore → 규칙 탭에 붙여넣거나 `firebase deploy --only firestore:rules`로
// 해야 반영된다 (파일이 저장소에 있다고 자동 적용되지 않음).
//
// 지금 Console에서 "테스트 모드"로 시작하면 30일간 아래 규칙 없이 모든
// 읽기/쓰기가 열려 있다 — 개발 중에는 편하지만, 실제 배포 전에는 반드시
// 이 규칙(또는 이에 준하는 것)으로 교체해야 한다. 그렇지 않으면 누구나
// 다른 사용자의 포인트/쿠폰을 임의로 조작할 수 있다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // 프로필은 로그인한 모두가 읽을 수 있어야 랭킹 집계(다른 유저 문서
      // 조회)가 가능하다. 쓰기는 본인 문서만 허용한다.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /coupons/{couponId} {
        // 쿠폰은 본인만 읽을 수 있다. 사용 처리(update)는 본인 또는 매장
        // 스캐너 화면에서도 결국 같은 로그인 사용자 컨텍스트로 이뤄지므로
        // 본인 조건으로 충분하다 — 매장주가 별도 계정으로 검증하는 구조는
        // 이번 범위 밖(QR 카메라 스캔 전환과 함께 다룰 예정).
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
